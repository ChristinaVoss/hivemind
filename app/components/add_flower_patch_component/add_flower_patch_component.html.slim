/             data-draw-polygon-map-hive-lng-value=hive.location.x
/             style="height: 400px; width: 600px;"

/   button.button.mt-4 data-draw-polygon-map-target="saveButton" data-action="click->draw-polygon-map#save"
/     | Save Flower Patch